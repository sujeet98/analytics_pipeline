# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=<your-bucket>
RAW_PREFIX=raw/thelook
BRONZE_PREFIX=bronze/thelook/delta

# Databricks SQL Warehouse (for external table creation & later queries)
DATABRICKS_SERVER_HOST=adb-xxxxxxxx.x.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_ACCESS_TOKEN=xxxxxxxxxxxxxxxx

# GCP BigQuery (choose ONE of the two)
GOOGLE_APPLICATION_CREDENTIALS=/dbfs/FileStore/creds/thelook-sa.json  # if you upload the JSON file
# OR
GCP_SA_KEY_%
GCP_PROJECT_ID=analyticsproject
