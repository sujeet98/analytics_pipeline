{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.11\", \"dbt_databricks_version\": \"1.10.12\", \"databricks_sql_connector_version\": \"4.0.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \nSELECT\n  table_name,\n  if(table_type IN ('EXTERNAL', 'MANAGED', 'MANAGED_SHALLOW_CLONE', 'EXTERNAL_SHALLOW_CLONE'), 'table', lower(table_type)) AS table_type,\n  lower(data_source_format) AS file_format,\n  table_owner,\n  if(\n    table_type IN (\n      'EXTERNAL',\n      'MANAGED',\n      'MANAGED_SHALLOW_CLONE',\n      'EXTERNAL_SHALLOW_CLONE'\n    ),\n    lower(table_type),\n    NULL\n  ) AS databricks_table_type\nFROM `system`.`information_schema`.`tables`\nWHERE table_catalog = 'sujeet_data_analytics_workspace' \n  AND table_schema = 'edr'\n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "091b43ff-4c9f-487f-8ffd-434d6f12b85d", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.11\", \"dbt_databricks_version\": \"1.10.12\", \"databricks_sql_connector_version\": \"4.0.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \nSELECT\n  table_name,\n  if(table_type IN ('EXTERNAL', 'MANAGED', 'MANAGED_SHALLOW_CLONE', 'EXTERNAL_SHALLOW_CLONE'), 'table', lower(table_type)) AS table_type,\n  lower(data_source_format) AS file_format,\n  table_owner,\n  if(\n    table_type IN (\n      'EXTERNAL',\n      'MANAGED',\n      'MANAGED_SHALLOW_CLONE',\n      'EXTERNAL_SHALLOW_CLONE'\n    ),\n    lower(table_type),\n    NULL\n  ) AS databricks_table_type\nFROM `system`.`information_schema`.`tables`\nWHERE table_catalog = 'sujeet_data_analytics_workspace' \n  AND table_schema = 'edr'\n\n  ", "name": "SQLQuery", "pid": 57770, "thread": "MainThread", "ts": "2025-10-27T20:33:56.310706Z"}}
