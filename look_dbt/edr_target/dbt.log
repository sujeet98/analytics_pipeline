{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.11\", \"dbt_databricks_version\": \"1.10.12\", \"databricks_sql_connector_version\": \"4.0.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"invocation_id\": \"c7ae2514-f216-4b05-a011-398cc3463b14\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n    with ordered_run_results as (\n      select\n        *,\n        row_number() over (partition by unique_id order by run_results.generated_at desc) as row_number\n      from `sujeet_data_analytics_workspace`.`edr`.`dbt_run_results` run_results\n      join `sujeet_data_analytics_workspace`.`edr`.`dbt_models` using (unique_id)\n    ),\n\n    latest_models_invocations as (\n      select distinct invocation_id\n      from ordered_run_results\n      where row_number = 1\n    )\n\n    select\n      invocation_id,\n      command,\n      selected,\n      full_refresh,\n      \n        job_url,\n      \n      job_name,\n      job_id,\n      orchestrator\n    from `sujeet_data_analytics_workspace`.`edr`.`dbt_invocations` invocations\n    join latest_models_invocations using (invocation_id)\n  \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "c7ae2514-f216-4b05-a011-398cc3463b14", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.11\", \"dbt_databricks_version\": \"1.10.12\", \"databricks_sql_connector_version\": \"4.0.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"invocation_id\": \"c7ae2514-f216-4b05-a011-398cc3463b14\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n    with ordered_run_results as (\n      select\n        *,\n        row_number() over (partition by unique_id order by run_results.generated_at desc) as row_number\n      from `sujeet_data_analytics_workspace`.`edr`.`dbt_run_results` run_results\n      join `sujeet_data_analytics_workspace`.`edr`.`dbt_models` using (unique_id)\n    ),\n\n    latest_models_invocations as (\n      select distinct invocation_id\n      from ordered_run_results\n      where row_number = 1\n    )\n\n    select\n      invocation_id,\n      command,\n      selected,\n      full_refresh,\n      \n        job_url,\n      \n      job_name,\n      job_id,\n      orchestrator\n    from `sujeet_data_analytics_workspace`.`edr`.`dbt_invocations` invocations\n    join latest_models_invocations using (invocation_id)\n  \n\n  ", "name": "SQLQuery", "pid": 57770, "thread": "MainThread", "ts": "2025-10-27T20:33:59.433193Z"}}
