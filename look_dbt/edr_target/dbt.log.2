{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.11\", \"dbt_databricks_version\": \"1.10.12\", \"databricks_sql_connector_version\": \"4.0.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"invocation_id\": \"68c6ab2f-3eee-4bf6-9f3d-8645cf3983af\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with model_runs as (\n            select\n                *,\n                row_number() over (partition by unique_id order by generated_at desc) as invocations_rank_index\n            from `sujeet_data_analytics_workspace`.`edr`.`model_run_results`\n        )\n\n        select\n            unique_id,\n            invocation_id,\n            name,\n            schema_name as schema,\n            status,\n            case\n                when status != 'success' then 0\n                else round(cast(execution_time as decimal(28,6)), 1)\n            end as execution_time,\n            full_refresh,\n            materialization,\n            case when invocations_rank_index = 1 then compiled_code else NULL end as compiled_code,\n            generated_at\n        from model_runs\n        where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(generated_at as timestamp)), nvl2(date(cast(generated_at as timestamp)), assert_true(date(cast(generated_at as timestamp)) is not null), null))\n\n) < 7\n        \n          and unique_id not like 'model.elementary.%'\n        \n        order by generated_at\n    \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "68c6ab2f-3eee-4bf6-9f3d-8645cf3983af", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.11\", \"dbt_databricks_version\": \"1.10.12\", \"databricks_sql_connector_version\": \"4.0.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"invocation_id\": \"68c6ab2f-3eee-4bf6-9f3d-8645cf3983af\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with model_runs as (\n            select\n                *,\n                row_number() over (partition by unique_id order by generated_at desc) as invocations_rank_index\n            from `sujeet_data_analytics_workspace`.`edr`.`model_run_results`\n        )\n\n        select\n            unique_id,\n            invocation_id,\n            name,\n            schema_name as schema,\n            status,\n            case\n                when status != 'success' then 0\n                else round(cast(execution_time as decimal(28,6)), 1)\n            end as execution_time,\n            full_refresh,\n            materialization,\n            case when invocations_rank_index = 1 then compiled_code else NULL end as compiled_code,\n            generated_at\n        from model_runs\n        where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(generated_at as timestamp)), nvl2(date(cast(generated_at as timestamp)), assert_true(date(cast(generated_at as timestamp)) is not null), null))\n\n) < 7\n        \n          and unique_id not like 'model.elementary.%'\n        \n        order by generated_at\n    \n\n  ", "name": "SQLQuery", "pid": 57770, "thread": "MainThread", "ts": "2025-10-27T20:33:51.060391Z"}}
