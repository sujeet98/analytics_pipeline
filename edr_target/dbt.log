ber,\\n    event_ts,\\n    event_date,\\n    ip_address,\\n    city,\\n    state,\\n    postal_code,\\n    browser,\\n    traffic_source,\\n    uri,\\n    event_type,\\n    canonical_updated_at,\\n    ingest_ts_utc\\n  from sujeet_data_analytics_workspace.silver_dev.int_commerce_events__look\\n  \\n    where event_date >= dateadd(day, -7, current_date())\\n  \\n),\\n\\nunioned as (\\n  select * from src_thelook\\n  -- union all select * from other sources with the same columns & filter\\n)\\n\\nselect\\n  concat(source_system, ':', cast(event_id as string)) as global_event_id,\\n  source_system,\\n  event_id,\\n  user_id,\\n  session_id,\\n  sequence_number,\\n  event_ts,\\n  event_date,\\n  ip_address,\\n  city,\\n  state,\\n  postal_code,\\n  browser,\\n  traffic_source,\\n  uri,\\n  event_type,\\n  canonical_updated_at,\\n  ingest_ts_utc\\nfrom unioned;\", \"generated_at\": \"2025-10-27 22:54:44\"}, {\"unique_id\": \"model.look_dbt.core_commerce_inventory_items\", \"invocation_id\": \"c89ed4cb-364e-4b77-84d6-3164092a6feb\", \"name\": \"core_commerce_inventory_items\", \"schema\": \"silver_dev\", \"status\": \"success\", \"execution_time\": 128.1, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\n\\n\\nwith tgt_max as (\\n  select\\n     coalesce(max(canonical_updated_at), timestamp('1900-01-01'))\\n     as max_ts\\n  from  sujeet_data_analytics_workspace.silver_dev.core_commerce_inventory_items \\n),\\n\\nsrc_look as (\\n  select\\n    'look'              as source_system,\\n    inventory_item_id,\\n    product_id,\\n    distribution_center_id,\\n    created_at,\\n    sold_at,\\n    created_date,\\n    unit_cost,\\n    retail_price,\\n    product_category,\\n    product_name,\\n    product_brand,\\n    product_department,\\n    product_sku,\\n    canonical_updated_at,\\n    ingest_ts_utc\\n  from sujeet_data_analytics_workspace.silver_dev.int_commerce_inventory_items__look\\n  \\n    where canonical_updated_at >= dateadd(day, -2, (select max_ts from tgt_max))\\n  \\n),\\n\\nunioned as (\\n  select * from src_look\\n  -- union all select * from other sources (same columns & filter)\\n)\\n\\nselect\\n  concat(source_system, ':', cast(inventory_item_id as string)) as global_inventory_item_id,\\n  source_system,\\n  inventory_item_id,\\n  product_id,\\n  distribution_center_id,\\n  created_at,\\n  sold_at,\\n  created_date,\\n  unit_cost,\\n  retail_price,\\n  product_category,\\n  product_name,\\n  product_brand,\\n  product_department,\\n  product_sku,\\n  canonical_updated_at,\\n  ingest_ts_utc\\nfrom unioned;\", \"generated_at\": \"2025-10-27 22:54:44\"}, {\"unique_id\": \"model.look_dbt.core_commerce_order_items\", \"invocation_id\": \"c89ed4cb-364e-4b77-84d6-3164092a6feb\", \"name\": \"core_commerce_order_items\", \"schema\": \"silver_dev\", \"status\": \"success\", \"execution_time\": 116.1, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\n\\n\\nwith tgt_max as (\\n  select\\n    \\n      coalesce(max(canonical_updated_at), timestamp('1900-01-01'))\\n     as max_ts\\n  from  sujeet_data_analytics_workspace.silver_dev.core_commerce_order_items \\n),\\n\\n-- ===== Add per-source aligned inputs (one CTE per source) =====\\nsrc_look as (\\n  select\\n    'look'            as source_system,\\n    order_item_id,\\n    order_id,\\n    user_id,\\n    product_id,\\n    inventory_item_id,\\n    item_status,\\n    created_at,\\n    shipped_at,\\n    delivered_at,\\n    returned_at,\\n    item_date,                -- analytic convenience\\n    created_date,             -- partition key (stable)\\n    cast(sale_price as numeric) as sale_price,\\n    canonical_updated_at,\\n    ingest_ts_utc\\n  from sujeet_data_analytics_workspace.silver_dev.int_commerce_order_items__look\\n  \\n    where canonical_updated_at >= dateadd(day, -14, (select max_ts from tgt_max))\\n  \\n),\\n\\nunioned as (\\n  select * from src_look\\n  -- union all select * from src_<other