{"data": {"msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"name\": \"stg_look__events\", \"unique_id\": \"model.look_dbt.stg_look__events\", \"database_name\": \"sujeet_data_analytics_workspace\", \"schema_name\": \"silver_dev\", \"table_name\": \"stg_look__events\", \"owners\": \"[\\\"growth-analytics@yourco.com\\\"]\", \"tags\": \"[\\\"look\\\", \\\"staging\\\"]\", \"package_name\": \"look_dbt\", \"description\": \"Staging (deduped) web/app events. Event types, traffic_source, and browser normalized to a controlled vocabulary. Purpose: provide clean sessions/funnel inputs and channel attribution signals.\\n\", \"materialization\": \"incremental\", \"patch_path\": \"look_dbt://models/staging/look/_look__models.yml\", \"full_path\": \"models/staging/look/stg_look__events.sql\", \"meta\": \"{\\\"owner\\\": \\\"growth-analytics@yourco.com\\\", \\\"tier\\\": \\\"bronze\\\", \\\"domain\\\": \\\"growth\\\"}\"}, {\"name\": \"stg_look__users\", \"unique_id\": \"model.look_dbt.stg_look__users\", \"database_name\": \"sujeet_data_analytics_workspace\", \"schema_name\": \"silver_dev\", \"table_name\": \"stg_look__users\", \"owners\": \"[\\\"core-data@yourco.com\\\"]\", \"tags\": \"[\\\"look\\\", \\\"staging\\\"]\", \"package_name\": \"look_dbt\", \"description\": \"Staging (deduped) users with basic normalization (gender, traffic_source). Purpose: serve as user master for staging joins (orders, items, events).\\n\", \"materialization\": \"incremental\", \"patch_path\": \"look_dbt://models/staging/look/_look__models.yml\", \"full_path\": \"models/staging/look/stg_look__users.sql\", \"meta\": \"{\\\"owner\\\": \\\"core-data@yourco.com\\\", \\\"tier\\\": \\\"bronze\\\", \\\"domain\\\": \\\"identity\\\"}\"}, {\"name\": \"stg_look__products\", \"unique_id\": \"model.look_dbt.stg_look__products\", \"database_name\": \"sujeet_data_analytics_workspace\", \"schema_name\": \"silver_dev\", \"table_name\": \"stg_look__products\", \"owners\": \"[\\\"merch-data@yourco.com\\\"]\", \"tags\": \"[\\\"look\\\", \\\"staging\\\"]\", \"package_name\": \"look_dbt\", \"description\": \"Staging (deduped) products; latest attributes per product_id. Includes DC mapping and price attributes. Purpose: authoritative product master in staging for joins to items/inventory.\\n\", \"materialization\": \"incremental\", \"patch_path\": \"look_dbt://models/staging/look/_look__models.yml\", \"full_path\": \"models/staging/look/stg_look__products.sql\", \"meta\": \"{\\\"owner\\\": \\\"merch-data@yourco.com\\\", \\\"tier\\\": \\\"bronze\\\", \\\"domain\\\": \\\"catalog\\\"}\"}, {\"name\": \"stg_look__inventory_items\", \"unique_id\": \"model.look_dbt.stg_look__inventory_items\", \"database_name\": \"sujeet_data_analytics_workspace\", \"schema_name\": \"silver_dev\", \"table_name\": \"stg_look__inventory_items\", \"owners\": \"[\\\"supply-chain-data@yourco.com\\\"]\", \"tags\": \"[\\\"look\\\", \\\"staging\\\"]\", \"package_name\": \"look_dbt\", \"description\": \"Staging (deduped) inventory units. Includes product attributes at ingest and unit-level cost/retail. Purpose: serve unit_cost at or near time of sale for margin calculations.\\n\", \"materialization\": \"incremental\", \"patch_path\": \"look_dbt://models/staging/look/_look__models.yml\", \"full_path\": \"models/staging/look/stg_look__inventory_items.sql\", \"meta\": \"{\\\"owner\\\": \\\"supply-chain-data@yourco.com\\\", \\\"tier\\\": \\\"bronze\\\", \\\"domain\\\": \\\"supply\\\"}\"}, {\"name\": \"stg_look__orders\", \"unique_id\": \"model.look_dbt.stg_look__orders\", \"database_name\": \"sujeet_data_analytics_workspace\", \"schema_name\": \"silver_dev\", \"table_name\": \"stg_look__orders\", \"owners\": \"[\\\"core-data@yourco.com\\\"]\", \"tags\": \"[\\\"look\\\", \\\"staging\\\"]\", \"package_name\": \"look_dbt\", \"description\": \"Staging (deduped) orders from the Look source. One row per order_id (latest by ingest_ts_utc). Purpose: provide a clean, timely orders header for downstream conformance and mar