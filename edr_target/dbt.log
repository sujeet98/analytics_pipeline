{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.11\", \"dbt_databricks_version\": \"1.10.12\", \"databricks_sql_connector_version\": \"4.0.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"invocation_id\": \"224155c7-f27f-4439-b25e-a53cca12bf89\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n              with dbt_artifacts_models as (\n                select\n                  name,\n                  unique_id,\n                  database_name,\n                  schema_name,\n                  case when alias is not null then alias\n                  else name end as table_name,\n                  owner as owners,\n                  tags,\n                  package_name,\n                  description,\n                  materialization,\n                  \n                  \n                    patch_path,\n                  \n                  original_path as full_path,\n                  meta\n                from `sujeet_data_analytics_workspace`.`edr`.`dbt_models`\n                \n                  where package_name != 'elementary'\n                \n              )\n\n             select * from dbt_artifacts_models\n        \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "224155c7-f27f-4439-b25e-a53cca12bf89", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.11\", \"dbt_databricks_version\": \"1.10.12\", \"databricks_sql_connector_version\": \"4.0.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"invocation_id\": \"224155c7-f27f-4439-b25e-a53cca12bf89\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n              with dbt_artifacts_models as (\n                select\n                  name,\n                  unique_id,\n                  database_name,\n                  schema_name,\n                  case when alias is not null then alias\n                  else name end as table_name,\n                  owner as owners,\n                  tags,\n                  package_name,\n                  description,\n                  materialization,\n                  \n                  \n                    patch_path,\n                  \n                  original_path as full_path,\n                  meta\n                from `sujeet_data_analytics_workspace`.`edr`.`dbt_models`\n                \n                  where package_name != 'elementary'\n                \n              )\n\n             select * from dbt_artifacts_models\n        \n\n  ", "name": "SQLQuery", "pid": 61770, "thread": "MainThread", "ts": "2025-10-28T00:40:12.347414Z"}}
