{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.11\", \"dbt_databricks_version\": \"1.10.12\", \"databricks_sql_connector_version\": \"4.0.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"invocation_id\": \"141af08f-d2f7-485d-8534-1a11a187f6a8\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with dbt_artifacts_seeds as (\n          select\n            name,\n            unique_id,\n            database_name,\n            schema_name,\n            case when alias is not null then alias\n            else name end as table_name,\n            owner as owners,\n            tags,\n            package_name,\n            description,\n            original_path as full_path\n          from `sujeet_data_analytics_workspace`.`edr`.`dbt_seeds`\n        )\n\n        select * from dbt_artifacts_seeds\n  \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "141af08f-d2f7-485d-8534-1a11a187f6a8", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.11\", \"dbt_databricks_version\": \"1.10.12\", \"databricks_sql_connector_version\": \"4.0.5\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"invocation_id\": \"141af08f-d2f7-485d-8534-1a11a187f6a8\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with dbt_artifacts_seeds as (\n          select\n            name,\n            unique_id,\n            database_name,\n            schema_name,\n            case when alias is not null then alias\n            else name end as table_name,\n            owner as owners,\n            tags,\n            package_name,\n            description,\n            original_path as full_path\n          from `sujeet_data_analytics_workspace`.`edr`.`dbt_seeds`\n        )\n\n        select * from dbt_artifacts_seeds\n  \n\n  ", "name": "SQLQuery", "pid": 61770, "thread": "MainThread", "ts": "2025-10-28T00:40:07.198501Z"}}
